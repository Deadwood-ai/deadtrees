{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/benchmark-datasets/dte-aerial-bench",
        "destination": "/releases/dte-aerial-bench",
        "type": 301
      },
      {
        "source": "/dte-aerial-bench",
        "destination": "/releases/dte-aerial-bench",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    }
  }
}
