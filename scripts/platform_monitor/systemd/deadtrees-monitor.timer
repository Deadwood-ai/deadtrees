[Unit]
Description=Run the DeadTrees monitor (every 30 minutes in working hours, every 2 hours otherwise)

[Timer]
# Working hours 06:00-18:00 Europe/Berlin: every 30 minutes. Outside them:
# every 2 hours. Berlin time, so the schedule follows daylight saving.
OnCalendar=*-*-* 06..17:07,37:00 Europe/Berlin
OnCalendar=*-*-* 00,02,04,18,20,22:07:00 Europe/Berlin
Persistent=true

[Install]
WantedBy=timers.target
