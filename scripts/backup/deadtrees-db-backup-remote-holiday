#!/usr/bin/env bash
set -euo pipefail

umask 077

readonly container="${DEADTREES_DB_CONTAINER:-supabase-db}"
readonly stage="${DEADTREES_DB_BACKUP_STAGE:-/home/dendro/.deadtrees-db-backup-stage}"
readonly df_bin="${DEADTREES_DB_BACKUP_DF_BIN:-df}"
readonly zstd_bin="${DEADTREES_DB_BACKUP_ZSTD_BIN:-zstd}"
readonly socket_path="${DEADTREES_DB_BACKUP_SOCKET_PATH:-/tmp/borg.sock}"
readonly socket_test_bin="${DEADTREES_DB_BACKUP_SOCKET_TEST_BIN:-/usr/bin/test}"
readonly ss_bin="${DEADTREES_DB_BACKUP_SS_BIN:-/usr/bin/ss}"
readonly docker_bin="${DEADTREES_DOCKER_BIN:-docker}"
readonly capacity_percent="${DEADTREES_DB_BACKUP_CAPACITY_PERCENT:-50}"
readonly reserve_bytes="${DEADTREES_DB_BACKUP_RESERVE_BYTES:-53687091200}"
readonly command="${SSH_ORIGINAL_COMMAND:-}"
readonly dump_file="$stage/postgres.dump.zst"
readonly preserve_marker="$stage/.deadtrees-preserve"

assert_dump_capacity() {
	local database_bytes available_bytes required_bytes
	if [[ ! "$capacity_percent" =~ ^[0-9]+$ || ! "$reserve_bytes" =~ ^[0-9]+$ ]]; then
		printf 'Dump capacity policy must use numeric values.\n' >&2
		exit 1
	fi
	database_bytes="$("$docker_bin" exec --user postgres "$container" \
		psql -XAt --username postgres --dbname postgres \
		--command "select pg_database_size('postgres');")"
	available_bytes="$("$df_bin" -PB1 "$(dirname "$stage")" | awk 'NR == 2 { print $4 }')"
	if [[ ! "$database_bytes" =~ ^[0-9]+$ || ! "$available_bytes" =~ ^[0-9]+$ ]]; then
		printf 'Could not determine database size and available dump capacity.\n' >&2
		exit 1
	fi
	required_bytes=$((database_bytes * capacity_percent / 100 + reserve_bytes))
	if [[ "$available_bytes" -lt "$required_bytes" ]]; then
		printf 'Insufficient dump capacity: required=%s available=%s database=%s.\n' \
			"$required_bytes" "$available_bytes" "$database_bytes" >&2
		exit 1
	fi
	printf 'capacity-ready required=%s available=%s database=%s\n' \
		"$required_bytes" "$available_bytes" "$database_bytes"
}

case "$command" in
	prepare)
		if [[ -f "$preserve_marker" ]]; then
			printf 'A recoverable database dump is preserved at %s.\n' "$stage" >&2
			exit 78
		fi
		exec rm -rf -- "$stage"
		;;
	dump)
		test ! -e "$stage"
		assert_dump_capacity >/dev/null
		mkdir -m 0700 -- "$stage"
		"$docker_bin" exec --user postgres "$container" \
			pg_dump --no-password --clean --if-exists --username postgres \
			--format custom --compress=0 postgres \
			| "$zstd_bin" -q -3 -T4 -c >"$dump_file.partial"
		mv -- "$dump_file.partial" "$dump_file"
		;;
	space-status)
		assert_dump_capacity
		;;
	stream-local)
		test -f "$dump_file"
		exec "$zstd_bin" -q -dc -- "$dump_file"
		;;
	verify)
		test -f "$dump_file"
		"$zstd_bin" -q -t -- "$dump_file"
		# pg_restore stops after the table of contents; zstd -t above covers the whole file.
		{ "$zstd_bin" -q -dc -- "$dump_file" || true; } \
			| "$docker_bin" exec -i --user postgres "$container" pg_restore --list >/dev/null
		printf 'verified\n'
		;;
	status)
		if [[ -d "$stage" ]]; then
			du -sb -- "$stage"
			if [[ -f "$preserve_marker" ]]; then
				printf 'preserved\n'
			fi
		else
			printf 'absent\n'
		fi
		;;
	preserve)
		test -f "$dump_file"
		exec touch -- "$preserve_marker"
		;;
	release)
		exec rm -f -- "$preserve_marker"
		;;
	tunnel-status)
		"$socket_test_bin" -S "$socket_path"
		"$ss_bin" -xlH | grep -Fq -- "$socket_path"
		printf 'ready\n'
		;;
	cleanup)
		if [[ -f "$preserve_marker" ]]; then
			printf 'Refusing to delete recoverable database dump at %s.\n' "$stage" >&2
			exit 78
		fi
		exec rm -rf -- "$stage"
		;;
	*)
		printf 'Command denied.\n' >&2
		exit 64
		;;
esac
