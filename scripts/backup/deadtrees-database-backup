#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly identity="${DEADTREES_DB_BACKUP_IDENTITY:-/home/remote-backup/.ssh/id_ed25519}"
readonly remote="${DEADTREES_DB_BACKUP_REMOTE:-dendro@data2.deadtrees.earth}"
readonly lock_file="${DEADTREES_DB_BACKUP_LOCK_FILE:-/home/remote-backup/.cache/deadtrees-database-backup.lock}"
readonly borgmatic="${DEADTREES_DB_BACKUP_BORGMATIC_BIN:-/home/remote-backup/.local/bin/borgmatic}"
readonly maintenance_config="${DEADTREES_DB_BACKUP_MAINTENANCE_CONFIG:-/home/remote-backup/.config/borgmatic/database_dump_direct.yaml}"
readonly repository="${DEADTREES_DB_BACKUP_REPOSITORY:-/mnt/raid/backups/supabase.deadtrees.earth}"
readonly ssh_bin="${DEADTREES_DB_BACKUP_SSH_BIN:-ssh}"
readonly borg_bin="${DEADTREES_DB_BACKUP_BORG_BIN:-borg}"
readonly archive_remote="${DEADTREES_DB_BACKUP_ARCHIVE_REMOTE:-borg@data2.deadtrees.earth}"
readonly archive_command="${DEADTREES_DB_BACKUP_ARCHIVE_COMMAND:-/home/borg/.local/bin/deadtrees-db-borg-archive}"
readonly archive_identity="${DEADTREES_DB_BACKUP_ARCHIVE_IDENTITY:-/home/remote-backup/.ssh/id_ed25519_database_archive}"
readonly archive_known_hosts="${DEADTREES_DB_BACKUP_ARCHIVE_KNOWN_HOSTS:-/home/remote-backup/.ssh/known_hosts}"
readonly archive_host_key_alias="${DEADTREES_DB_BACKUP_ARCHIVE_HOST_KEY_ALIAS:-data2-database-archive}"
readonly flock_bin="${DEADTREES_DB_BACKUP_FLOCK_BIN:-flock}"
readonly retry_delay="${DEADTREES_DB_BACKUP_RETRY_DELAY:-5}"

archives_before=""
archives_after=""
new_archives=""
new_archive_count=0
archive_status=0
export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes

ssh_remote() {
	"$ssh_bin" \
		-i "$identity" \
		-o BatchMode=yes \
		-o ConnectTimeout=15 \
		-o ServerAliveInterval=30 \
		-o ServerAliveCountMax=4 \
		-o StrictHostKeyChecking=yes \
		"$remote" "$1"
}

cleanup() {
	ssh_remote cleanup >/dev/null 2>&1 || true
	if [[ -n "$archives_before" ]]; then
		rm -f "$archives_before"
	fi
	if [[ -n "$archives_after" ]]; then
		rm -f "$archives_after"
	fi
}

list_archives() {
	"$borg_bin" list --format '{archive}{NL}' "$repository" | sort
}

refresh_archive_diff() {
	list_archives >"$archives_after"
	new_archives="$(comm -13 "$archives_before" "$archives_after")"
	new_archive_count="$(printf '%s\n' "$new_archives" \
		| awk 'NF && $0 !~ /[.]checkpoint([.][0-9]+)?$/ { count += 1 } END { print count + 0 }')"
}

run_archive_transport() {
	set +e
	ssh_archive archive
	archive_status=$?
	set -e
}

ssh_archive() {
	local mode="$1"
	"$ssh_bin" \
		-i "$archive_identity" \
		-o BatchMode=yes \
		-o ConnectTimeout=15 \
		-o IdentitiesOnly=yes \
		-o ServerAliveInterval=30 \
		-o ServerAliveCountMax=4 \
		-o StrictHostKeyChecking=yes \
		-o "UserKnownHostsFile=$archive_known_hosts" \
		-o "HostKeyAlias=$archive_host_key_alias" \
		"$archive_remote" \
		"$archive_command $mode"
}

timestamp() {
	date '+%Y-%m-%dT%H:%M:%S%z'
}

exec 9>"$lock_file"
if ! "$flock_bin" -n 9; then
	printf 'Another database backup is already running.\n' >&2
	exit 75
fi

trap cleanup EXIT INT TERM

ssh_remote tunnel-status >/dev/null
ssh_archive probe >/dev/null
ssh_remote cleanup >/dev/null
ssh_remote space-status >/dev/null

start_epoch="$(date +%s)"
printf '%s Starting local PostgreSQL directory dump.\n' "$(timestamp)"
ssh_remote dump
ssh_remote verify >/dev/null
dump_finished_epoch="$(date +%s)"
printf '%s PostgreSQL dump completed in %s seconds; database connections are closed.\n' \
	"$(timestamp)" "$((dump_finished_epoch - start_epoch))"

printf '%s Starting direct Borg archival from the database host.\n' "$(timestamp)"
archives_before="$(mktemp)"
archives_after="$(mktemp)"
list_archives >"$archives_before"

run_archive_transport
refresh_archive_diff
if [[ "$archive_status" -ne 0 && "$new_archive_count" -eq 0 ]]; then
	printf '%s Borg transport exited %s without committing an archive; retrying once.\n' \
		"$(timestamp)" "$archive_status" >&2
	sleep "$retry_delay"
	ssh_remote tunnel-status >/dev/null
	run_archive_transport
	refresh_archive_diff
fi

ssh_remote cleanup >/dev/null
if [[ "$new_archive_count" -ne 1 ]]; then
	printf 'Expected exactly one completed new Borg archive, found %s; transport exit status was %s.\n' \
		"$new_archive_count" "$archive_status" >&2
	exit 1
fi

new_archive="$(printf '%s\n' "$new_archives" | awk 'NF && $0 !~ /[.]checkpoint([.][0-9]+)?$/')"
if [[ "$new_archive" != database-dump-* ]]; then
	printf 'Unexpected new Borg archive name: %s\n' "$new_archive" >&2
	exit 1
fi
if ! "$borg_bin" list --short "$repository::$new_archive" | grep -Fxq 'postgres-directory.tar'; then
	printf 'New Borg archive %s does not contain postgres-directory.tar.\n' "$new_archive" >&2
	exit 1
fi

if [[ "$archive_status" -ne 0 ]]; then
	printf '%s Borg transport exited %s after committing %s; verifying all archive data before continuing.\n' \
		"$(timestamp)" "$archive_status" "$new_archive" >&2
	"$borg_bin" check \
		--archives-only \
		--verify-data \
		--glob-archives "$new_archive" \
		"$repository"
	printf '%s Verified committed archive %s despite the transport teardown error.\n' \
		"$(timestamp)" "$new_archive"
fi

printf '%s Applying retention and verifying the new Borg repository.\n' "$(timestamp)"
"$borgmatic" --config "$maintenance_config" prune
"$borgmatic" --config "$maintenance_config" compact
"$borgmatic" --config "$maintenance_config" check

finished_epoch="$(date +%s)"
printf '%s Backup completed in %s seconds total.\n' \
	"$(timestamp)" "$((finished_epoch - start_epoch))"
