[Unit]
Description=Reverse SSH tunnel to %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=remote-backup
ExecStart=/usr/bin/ssh -T \
  -i /home/remote-backup/.ssh/id_ed25519_database_tunnel \
  -o ExitOnForwardFailure=yes \
  -o IdentitiesOnly=yes \
  -o ServerAliveInterval=60 \
  -o ServerAliveCountMax=3 \
  -o StreamLocalBindUnlink=yes \
  -o UserKnownHostsFile=/home/remote-backup/.ssh/known_hosts \
  -o HostKeyAlias=data2-database-tunnel \
  -R /run/deadtrees-database-backup/borg.sock:/run/remote-backup/database-borg.sock \
  borg@%i /home/borg/.local/bin/deadtrees-borg-tunnel-guard hold
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
